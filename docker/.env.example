PROJECT_BASE=../../
DATA_DIR=./data/
PROJECT_NAME=gsapi

BUILD_PROFILE=dev

# Shared by the CDN and this site; empty binds the cookie to this host only, so the CDN never sees it.
DSP_COOKIE_DOMAIN=.example.com
# Must match the prefix used on the issuing side (dsp.cookie.prefix); a mismatch shows up as every protected request returning missing-field.
DSP_COOKIE_PREFIX=DSP-
DSP_COOKIE_PATH=/
DSP_COOKIE_SECURE=true
DSP_COOKIE_HTTP_ONLY=true
DSP_COOKIE_SAME_SITE=Lax
# At least 32 bytes; shorter fails at startup.
DSP_SIGNING_SECRET_KEY=
# Seconds; doubles as the cookie Max-Age and is the only lifetime knob.
DSP_SIGNING_EXPIRY_SECONDS=3600

# Comma separated, no spaces (a space becomes part of the token). The comma cannot be escaped:
# a comma inside a token splits it into two slots and a long one may survive silently.
# At least 32 bytes each, one per edge device, slots distinct; left blank on purpose.
DSP_EDGE_TOKENS=
# Seconds of clock skew allowed on the callback timestamp; beyond it, treated as a replay.
DSP_EDGE_CALLBACK_WINDOW_SECONDS=300
# Seconds; must stay well below DSP_SIGNING_EXPIRY_SECONDS or startup fails.
DSP_EDGE_TICKET_TOLERANCE_SECONDS=30

NACOS_PORT_HTTP=8848
NACOS_PORT_GRPC_CLIENT=9848
NACOS_PORT_GRPC_SERVER=9849
NACOS_USER=nacos
NACOS_PASS=nacos

MINIO_PORT_API=11090
MINIO_PORT_CONSOLE=11091
MINIO_PORT_PROXY=11092
# [[fullPath]] is the path placeholder.
MINIO_URL_TEMPLATE=http://localhost:11092/[[fullPath]]
# Where direct API access ends up; must point at MINIO_PORT_CONSOLE.
MINIO_REDIRECT_URL=http://localhost:11091
# Password >8 chars. Root logs into the console; non-root is the one API access uses.
MINIO_ROOT_USER=admin
MINIO_ROOT_PASS=pw12345678
MINIO_BUCKET_IMAGE=images
# Access key length must be 3-20.
MINIO_KEY=KYJG_UPLOAD_KEY
MINIO_SECRET=KYJG_UPLOAD_SECRET

MINIO_IMG2WEBP_TZ=Asia/Shanghai
MINIO_IMG2WEBP_QUALITY=80
# 0 = upload .webp; 1 = replace origin with webp; 2 = upload .webp and delete origin.
MINIO_IMG2WEBP_MODE=0

ALIST_PUID=0
ALIST_PGID=0
ALIST_UMASK=022
ALIST_PORT=11095
ALIST_ROOT_PASSWORD=12345678
ALIST_USERNAME=upload
ALIST_PASSWORD=87654321
ALIST_MOUNT_PATH=/upload_imgs
# Cache expiration in minutes
ALIST_CACHE_EXPIRE=30

REDIS_PORT=11071

PGSQL_PORT=11070
PGSQL_USER=genshin_map
PGSQL_PASS=genshin_map
PGSQL_DB=genshin_map
PGSQL_SCHEMA=genshin_map

API_PORT=11081
GATEWAY_PORT=11080

IMG_LOCAL_PORT=11099
