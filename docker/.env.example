PROJECT_BASE=../../
DATA_DIR=./data/
PROJECT_NAME=gsapi

BUILD_PROFILE=dev

NACOS_PORT_HTTP=8848
NACOS_PORT_GRPC_CLIENT=9848
NACOS_PORT_GRPC_SERVER=9849
NACOS_USER=nacos
NACOS_PASS=nacos

MINIO_PORT_API=11090
MINIO_PORT_CONSOLE=11091
MINIO_PORT_PROXY=11092
# Use [[fullPath]] for path placeholder.
MINIO_URL_TEMPLATE=http://localhost:11092/[[fullPath]]
# Url for redirecting direct api access to console portal.
# Default is http://localhost:${MINIO_PORT_CONSOLE}
MINIO_REDIRECT_URL=http://localhost:11091
# Notes:
#   - MinIO password should be more than 8 characters
#   - Root password is password to login console
#   - Non-root password is for foreign API access
MINIO_ROOT_USER=admin
MINIO_ROOT_PASS=pw12345678
MINIO_BUCKET_IMAGE=images
# Note: Access key length should be between 3 and 20
MINIO_KEY=KYJG_UPLOAD_KEY
MINIO_SECRET=KYJG_UPLOAD_SECRET

MINIO_IMG2WEBP_TZ=Asia/Shanghai
MINIO_IMG2WEBP_QUALITY=80
# MINIO_IMG2WEBP_MODE valid values:
#   0: Upload .webp to minio
#   1: Replace origin image with webp content
#   2: Upload .webp to minio and delete origin image
MINIO_IMG2WEBP_MODE=0

ALIST_PUID=0
ALIST_PGID=0
ALIST_UMASK=022
ALIST_PORT=11095
ALIST_ROOT_PASSWORD=12345678
ALIST_USERNAME=upload
ALIST_PASSWORD=87654321
ALIST_MOUNT_PATH=/upload_imgs
# Cache expiration in minutes
ALIST_CACHE_EXPIRE=30

REDIS_PORT=11071

PGSQL_PORT=11070
PGSQL_USER=genshin_map
PGSQL_PASS=genshin_map
PGSQL_DB=genshin_map
PGSQL_SCHEMA=genshin_map

API_PORT=11081
GATEWAY_PORT=11080

IMG_LOCAL_PORT=11099

# Must match the allowlisted callback URL on the CDN side exactly.
# The edge calls it over the public network, so use the public address, not a container service name.
DSP_AUTH_SERVER_URL=http://localhost:11080
# Must be a domain shared by the CDN and this site.
# If empty, the cookie is bound to this host only and the browser will not send it to the CDN.
DSP_COOKIE_DOMAIN=.example.com
DSP_COOKIE_PREFIX=DSP-
DSP_COOKIE_PATH=/
DSP_COOKIE_SECURE=true
DSP_COOKIE_HTTP_ONLY=true
DSP_COOKIE_SAME_SITE=Lax
# Note: must be at least 32 bytes, a shorter key fails at startup
DSP_SIGNING_SECRET_KEY=
# Ticket lifetime in seconds; also the cookie Max-Age, the only knob for lifetime
DSP_SIGNING_EXPIRY_SECONDS=3600
